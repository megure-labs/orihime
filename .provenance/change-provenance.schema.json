{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://megure.ai/schemas/kaname-change-provenance-v1.json",
  "title": "Kaname-compatible change provenance",
  "description": "Public, content-bound index for a complete private Kaname provenance trace.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "change",
    "kaname",
    "evidence",
    "actors",
    "external_materials",
    "validation",
    "clean_room"
  ],
  "properties": {
    "schema": { "const": "kaname.change-provenance/v1" },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "base_commit", "summary", "patch_digest"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$" },
        "repository": { "const": "megure-labs/orihime" },
        "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "summary": { "type": "string", "minLength": 1 },
        "patch_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "kaname": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "attempt_ids",
        "host_nodes",
        "repro_manifest_digest",
        "dispatch_proof_digest",
        "trace_bundle_digest",
        "ledger_revision",
        "ledger_root_digest",
        "closure_certificate_digest",
        "status"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "attempt_ids": { "$ref": "#/$defs/nonemptyUniqueStrings" },
        "host_nodes": { "$ref": "#/$defs/nonemptyUniqueStrings" },
        "repro_manifest_digest": { "$ref": "#/$defs/digest" },
        "dispatch_proof_digest": { "$ref": "#/$defs/digest" },
        "trace_bundle_digest": { "$ref": "#/$defs/digest" },
        "ledger_revision": { "type": "integer", "minimum": 1 },
        "ledger_root_digest": { "$ref": "#/$defs/digest" },
        "closure_certificate_digest": { "$ref": "#/$defs/digest" },
        "status": { "const": "closed" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_graph_digest",
        "inputs_digest",
        "commands_digest",
        "tool_calls_digest",
        "transcripts_digest",
        "artifacts_digest",
        "environment_digest",
        "budget_outcome_digest",
        "validation_digest",
        "review_digest",
        "adjudication_digest"
      ],
      "properties": {
        "task_graph_digest": { "$ref": "#/$defs/digest" },
        "inputs_digest": { "$ref": "#/$defs/digest" },
        "commands_digest": { "$ref": "#/$defs/digest" },
        "tool_calls_digest": { "$ref": "#/$defs/digest" },
        "transcripts_digest": { "$ref": "#/$defs/digest" },
        "artifacts_digest": { "$ref": "#/$defs/digest" },
        "environment_digest": { "$ref": "#/$defs/digest" },
        "budget_outcome_digest": { "$ref": "#/$defs/digest" },
        "validation_digest": { "$ref": "#/$defs/digest" },
        "review_digest": { "$ref": "#/$defs/digest" },
        "adjudication_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "roles", "provider", "model", "harness", "effort"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["human", "agent", "service"] },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["accountable", "author", "implementer", "reviewer", "adjudicator"] }
          },
          "provider": { "type": ["string", "null"] },
          "model": { "type": ["string", "null"] },
          "harness": { "type": ["string", "null"] },
          "effort": { "type": ["string", "null"] }
        }
      }
    },
    "external_materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "locator", "purpose", "license", "digest", "implementation_source_viewed"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
          "implementation_source_viewed": { "type": "boolean" }
        }
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "environment", "outcome", "evidence_digest"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "environment": { "type": "string", "minLength": 1 },
          "outcome": { "const": "passed" },
          "evidence_digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "clean_room": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_implementation_source_viewed",
        "clean_room_restart_performed",
        "maintainer_decision_digest"
      ],
      "properties": {
        "external_implementation_source_viewed": { "type": "boolean" },
        "clean_room_restart_performed": { "type": "boolean" },
        "maintainer_decision_digest": {
          "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "nonemptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
